{
  "flags": {
    "check": [
      "Features\\.enabled\\?\\(\\s*:(?<flag>\\w+)",
      "Flipper\\.enabled\\?\\(\\s*:(?<flag>\\w+)",
      "feature_enabled\\?\\(\\s*:(?<flag>\\w+)",
      "isFeatureEnabled\\(\\s*[\"'](?<flag>[\\w.-]+)"
    ],
    "test_on": [
      "with_flag\\(\\s*:(?<flag>\\w+)",
      "enable_flag\\(\\s*:(?<flag>\\w+)",
      "Flipper\\.enable\\(\\s*:(?<flag>\\w+)"
    ],
    "test_off": [
      "without_flag\\(\\s*:(?<flag>\\w+)",
      "disable_flag\\(\\s*:(?<flag>\\w+)",
      "Flipper\\.disable\\(\\s*:(?<flag>\\w+)"
    ]
  },
  "entry": {
    "controller": "(^|/)controllers?/",
    "graphql": "(^|/)(graphql|resolvers?|mutations?)/",
    "job": "(^|/)(jobs?|workers?|sidekiq)/",
    "consumer": "(^|/)(consumers?|subscribers?|webhooks?)/",
    "middleware": "(^|/)(middleware|rack)/",
    "task": "(^|/)(lib/tasks|tasks/maintenance)/"
  },
  "sensitive": ["money", "auth", "secret", "tenant", "data"],
  "hot": { "paths": [], "fan_in": 5 },
  "trust_found_callers": false,
  "signals": {
    "write": "\\.(update|update!|update_all|update_columns?|save|save!|create|create!|insert_all|upsert_all|delete_all|destroy|destroy!|destroy_all|increment!|decrement!|touch)\\b",
    "enqueue": "\\.(perform_later|perform_async|perform_in|deliver_later|enqueue|publish)\\b",
    "cache_key": "(cache_key|Rails\\.cache\\.|\\.cache\\.(fetch|write|read)|memoize)",
    "serialization": "\\b(as_json|to_json|serialize|Marshal\\.|to_msgpack|GlobalID|JSON\\.(dump|generate))\\b"
  },
  "ungateable": {
    "migration": "(^|/)db/(migrate|data)/",
    "schema": "(^|/)(db/schema\\.rb|db/structure\\.sql)$",
    "config": "(^|/)config/|\\.(ya?ml|toml|env)$",
    "dependency": "(^|/)(Gemfile(\\.lock)?|package(-lock)?\\.json|pnpm-lock\\.yaml|yarn\\.lock)$"
  },
  "migration": {
    "additive": "\\b(create_table|add_column|add_index|add_reference|add_timestamps|add_foreign_key|add_check_constraint)\\b",
    "destructive": "\\b(drop_table|remove_column|remove_columns|rename_column|rename_table|change_column|change_column_null|change_column_default|remove_index|remove_reference|execute|update_all|delete_all)\\b|null:\\s*false"
  }
}
