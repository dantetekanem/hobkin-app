<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What the carried Node needs under the hardened runtime on Apple silicon (016-packaging, A9):
  allow-jit for V8's compiled code, and disable-library-validation so it loads native modules signed by
  someone else, as Pi extensions and the projects hobkin checks may carry. Node's own release asks for more.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
