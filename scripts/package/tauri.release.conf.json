{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* http://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src http: https:"
    }
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "resources": {
      "../dist/package/app/": "app/",
      "../dist/package/node/": "node/"
    },
    "macOS": {
      "minimumSystemVersion": "13.5"
    }
  },
  "plugins": {
