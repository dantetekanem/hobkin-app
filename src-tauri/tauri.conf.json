{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hobkin",
  "version": "../package.json",
  "identifier": "dev.hobkin.client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5187",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "hobkin",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 18 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* http://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
