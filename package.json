{
  "name": "hobkin-client",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A Mac client for hobkin: the conversation on the left, its work on the right.",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "imports": {
    "#shared/*": "./shared/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"shared/test/**/*.test.ts\" \"host/test/**/*.test.ts\" \"ui/test/**/*.test.ts\"",
    "check:contrast": "node scripts/contrast.ts",
    "tauri": "tauri",
    "host": "node host/src/main.ts",
    "host:dev": "node host/src/main.ts --dev",
    "host:live": "node host/src/main.ts --dev --live"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dagrejs/dagre": "^3.1.3",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2.12.4",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "diff": "^9.0.0",
    "hobkin": "link:../hobkin",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "typebox": "^1.4.6",
    "ws": "^8.22.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
